# ── Service ──────────────────────────────────────────────────────────────────
MA_HOST=127.0.0.1
MA_PORT=3010
LOG_LEVEL=info
# Comma-separated. The browser calls this API directly, so every origin that
# should be able to reach it has to be listed here.
MA_WEB_ORIGIN=http://localhost:3000,https://meAsAgent.vercel.app

# ── Storage ──────────────────────────────────────────────────────────────────
MA_DB_CONNECTION_STRING=mongodb+srv://...
MA_DB_NAME=measagent

# ── Language model (Stage 1) ─────────────────────────────────────────────────
# Amazon Bedrock's OpenAI-compatible gateway.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# Leave unset in production; overrides the gateway base URL.
# BEDROCK_BASE_URL=

# ── Voice (Stage 2 / 3) ──────────────────────────────────────────────────────
# Kokoro-82M text-to-speech through the HuggingFace router.
HF_TOKEN=
# Bearer token the standalone speech-to-speech service presents to /v1/chat/completions.
MA_S2S_API_KEY=

# ── Sign-in (Stage 4) ────────────────────────────────────────────────────────
# Signs the session tokens the browser carries. Any long random string:
#   openssl rand -hex 32
# Changing it signs everybody out. With this or the client id below unset, the
# service still runs and every conversation stays anonymous.
MA_SESSION_SECRET=
# The OAuth 2.0 Web application client id from the Google Cloud console. The
# same value goes in web/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
MA_GOOGLE_CLIENT_ID=

# ── Admin portal ─────────────────────────────────────────────────────────────
# The single login for admin/. The portal's server calls this api directly, so
# its origin does not need to be in MA_WEB_ORIGIN. Generate the hash with
#   bun run admin:hash-password
# and paste its output as printed. It is the argon2 hash base64-encoded: a raw
# hash is full of `$`, and Bun expands `$name` in .env values even inside quotes.
# Both empty means admin sign-in is refused. Restart the api after changing
# either — `bun --watch` reloads code but keeps the environment it started with.
MA_ADMIN_USERNAME=
MA_ADMIN_PASSWORD_HASH=
