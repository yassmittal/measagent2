# ── Service ──────────────────────────────────────────────────────────────────
MA_HOST=127.0.0.1
MA_PORT=3010
LOG_LEVEL=info
# Comma-separated. The browser calls this API directly, so every origin that
# should be able to reach it has to be listed here.
MA_WEB_ORIGIN=http://localhost:3000,https://meAsAgent.vercel.app

# ── Storage ──────────────────────────────────────────────────────────────────
MA_DB_CONNECTION_STRING=mongodb+srv://...
MA_DB_NAME=measagent

# ── Language model (Stage 1) ─────────────────────────────────────────────────
# Amazon Bedrock's OpenAI-compatible gateway.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# Leave unset in production; overrides the gateway base URL.
# BEDROCK_BASE_URL=

# ── Voice (Stage 2 / 3) ──────────────────────────────────────────────────────
# Kokoro-82M text-to-speech through the HuggingFace router.
HF_TOKEN=
# Streaming speech-to-text; the browser holds the socket, this only mints tokens.
ASSEMBLYAI_API_KEY=
# Bearer token the standalone speech-to-speech service presents to /v1/chat/completions.
MA_S2S_API_KEY=
